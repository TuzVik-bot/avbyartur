diff --git a/web/src/components/category-navigation.module.css b/web/src/components/category-navigation.module.css
new file mode 100644
index 0000000..c14c740
--- /dev/null
+++ b/web/src/components/category-navigation.module.css
@@ -0,0 +1,27 @@
+.navigation { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 32px; padding: 24px 0; }
+.group { min-width: 0; }
+.heading { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 14px; font-weight: 700; color: var(--muted); }
+.heading svg { flex-shrink: 0; color: var(--accent); }
+.links { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
+.group:nth-child(2) .links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.link { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; padding: 10px 12px; border-radius: 8px; font-size: 15px; font-weight: 600; transition: background-color .15s, color .15s; }
+.link svg { flex-shrink: 0; color: var(--muted); }
+.link:hover, .link:focus-visible { background: var(--soft-accent); color: var(--accent-dark); }
+.link:hover svg { color: var(--accent-dark); }
+.disclosure { border-top: 1px solid var(--line); background: var(--surface); }
+.summary { display: flex; align-items: center; gap: 10px; min-height: 52px; padding-block: 8px; font-size: 14px; font-weight: 700; cursor: pointer; list-style: none; }
+.summary::-webkit-details-marker { display: none; }
+.summary:hover { color: var(--accent-dark); background: var(--soft-accent); }
+.summary > svg:first-child { color: var(--accent); }
+.chevron { margin-left: 16px; transition: transform .15s; }
+.disclosure[open] .chevron { transform: rotate(180deg); }
+.panel { max-height: calc(100dvh - 160px); overflow-y: auto; overscroll-behavior: contain; border-top: 1px solid var(--line); }
+@media (max-width: 760px) {
+ .navigation { grid-template-columns: 1fr; gap: 20px; padding: 20px 0; }
+ .group + .group { padding-top: 20px; border-top: 1px solid var(--line); }
+ .links, .group:nth-child(2) .links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+ .link { height: 100%; padding: 10px 8px; font-size: 14px; }
+ .heading { margin-bottom: 8px; }
+}
+@media (max-width: 360px) { .links, .group:nth-child(2) .links { grid-template-columns: 1fr; } }
+@media (prefers-reduced-motion: reduce) { .link, .chevron { transition: none; } }
