# Авторынок: пример .env для docker compose. Только заглушки, без реальных секретов.
# Avtorinok: example .env for docker compose. Placeholders only, never real secrets.
# Copy to .env (chmod 600) and fill in. Empty secret = feature disabled.
# Keep in sync with docker-compose.yml and backend/app/config.py
# (backend/tests/test_compose_settings.py checks it).

# --- Compose / образы и тома / images and volumes ---
AVTORINOK_IMAGE_TAG=local
APP_PORT=8080
POSTGRES_VOLUME_NAME=avtorinok_postgres
PRIVATE_MEDIA_VOLUME=avtorinok_private_media

# --- База данных / database (DATABASE_URL is built by compose) ---
POSTGRES_DB=avtorinok
POSTGRES_USER=avtorinok
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Сессии и окружение / sessions and environment ---
APP_ENV=production
SESSION_SECRET=change-me-min-32-chars-random-string
SESSION_COOKIE_NAME=avtorinok_session
SESSION_COOKIE_SECURE=true
SESSION_DAYS=7
# Docker/LAN private ranges; the API port is reachable only from the app network.
# 192.168.0.0/16 also covers the external OpenResty: while it does not forward the
# real client address, IP-scoped limits fall back to a coarse site-wide cap.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
PUBLIC_APP_URL=https://xn--80aeylebmo7f.xn--90ais

# --- Web (Next.js) ---
SITE_NAME=Авторынок BY
SITE_ORIGIN=https://авторынок.бел
GA_MEASUREMENT_ID=
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
# Comma-separated OpenRouter model ids ending in :free, max 3; empty = disabled.
ASSISTANT_FALLBACK_MODELS=
# Daily cap on model calls; when exhausted the assistant answers in basic mode.
ASSISTANT_DAILY_MODEL_BUDGET=45

# --- Квоты и объявления / quotas and listings ---
PRIVATE_LISTING_QUOTA=5
COMPANY_LISTING_QUOTA=50
LISTING_AUTO_PUBLISH_ENABLED=false
SAVED_SEARCH_LIMIT=20
SAVED_SEARCH_MUTATIONS_PER_HOUR=60
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=60000000
LISTING_STOP_WORDS_CSV=
MINIMUM_PHOTOS_NEW=1
MINIMUM_PHOTOS_USED=1
MINIMUM_PHOTOS_DAMAGED=1
MINIMUM_PHOTOS_PARTS=1
LISTING_YEAR_MIN=1886
LISTING_FUTURE_NEW_YEARS=1

# --- Регистрация и вход / registration and login ---
EMAIL_REGISTRATION_ENABLED=false
EMAIL_REGISTRATION_PILOT_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_GUEST_CONTACT_ENABLED=false
GUEST_CONTACT_IP_HOURLY_LIMIT=30
REGISTRATION_TERMS_VERSION=
REGISTRATION_PRIVACY_VERSION=

# --- SMS вход / SMS login (SMS_OTP_SECRET >= 32 chars when enabled) ---
SMS_LOGIN_ENABLED=false
SMS_OTP_SECRET=
SMS_OTP_LIFETIME_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_SENDS_PER_HOUR=5
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_IP_REQUESTS_PER_HOUR=30
SMS_OTP_IP_VERIFICATIONS_PER_HOUR=30
SMS_OTP_PHONE_VERIFICATIONS_PER_HOUR=10
SMS_PROVIDER=disabled
SMSC_API_KEY=
SMSC_API_URL=https://smsc.ru/sys/send.php
SMSC_SENDER=
SMSC_TIMEOUT_SECONDS=5

# --- Почта / email (SMTP_USERNAME and SMTP_PASSWORD go together) ---
TEST_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# --- Мониторинг / monitoring ---
SENTRY_DSN=
# Container path of the host monitor status file (needs a volume mount).
MONITORING_STATUS_PATH=

# --- Onliner sync (ONLINER_SYNC_OWNER_EMAIL required when enabled) ---
ONLINER_BASE_URL=https://ab.onliner.by/sdapi/ab.api
ONLINER_REQUEST_INTERVAL_SECONDS=1.0
ONLINER_PER_MAKE_LIMIT=10
ONLINER_MAX_PHOTOS=30
ONLINER_SYNC_ENABLED=false
ONLINER_SYNC_OWNER_EMAIL=
ONLINER_SYNC_INTERVAL_HOURS=6
ONLINER_SYNC_MANUFACTURERS=all

# --- Хост-монитор / host monitor (NOT read by compose) ---
# Put these in a separate root-only file passed via --alert-env-file,
# e.g. /etc/avtorinok/monitor-alerts.env (chmod 600):
# MONITOR_TELEGRAM_BOT_TOKEN=
# MONITOR_TELEGRAM_CHAT_ID=
